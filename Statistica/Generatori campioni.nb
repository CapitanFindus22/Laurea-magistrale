Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Distribuzioni", " ", "scelte"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"titoli", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<Uniforme\>\"", ",", "\"\<Normale\>\"", 
       ",", "\"\<Beta\>\""}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dist", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"UniformDistribution", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "10"}], ",", "20"}], "}"}], "]"}], ",", 
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"0", ",", "1"}], "]"}], ",", 
       RowBox[{"BetaDistribution", "[", 
        RowBox[{"4", ",", "1"}], "]"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Trovo", " ", "le", " ", "CDF", " ", "inverse"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"campioni", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"InverseCDF", "[", 
        RowBox[{"#", ",", "u1"}], "]"}], "&"}], "/@", "dist"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "Grafici", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"GraphicsGrid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"MapThread", "[", 
       RowBox[{"creaPlot", ",", 
        RowBox[{"{", 
         RowBox[{"dist", ",", "campioni", ",", "titoli"}], "}"}]}], "]"}], 
      "}"}], ",", 
     RowBox[{"ImageSize", "->", "Full"}]}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
