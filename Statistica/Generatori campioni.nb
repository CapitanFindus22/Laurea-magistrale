Cell["Generatori di campioni casuali", "Chapter",
 CellChangeTimes->{
  3.9931871080474567`*^9},ExpressionUUID->"e2b3b06b-1fef-aa4d-977c-\
f3e65fb9d003"],

Cell[CellGroupData[{

Cell["Inizializzazione", "Section",
 CellChangeTimes->{
  3.993187145759495*^9},ExpressionUUID->"c8ad5e3d-7395-ee46-be0e-\
172e3de068bb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", "5000"}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Numeri", " ", "casuali", " ", "uniformi"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"u1", "=", 
   RowBox[{"RandomVariate", "[", 
    RowBox[{
     RowBox[{"UniformDistribution", "[", "]"}], ",", "n"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"u2", "=", 
    RowBox[{"RandomVariate", "[", 
     RowBox[{
      RowBox[{"UniformDistribution", "[", "]"}], ",", "n"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Funzione", " ", "di", " ", "disegno", " ", "grafici"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"creaPlot", "[", 
   RowBox[{"dist_", ",", "campioni_", ",", "titolo_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"xmin", ",", "xmax"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"xmin", "=", 
      RowBox[{"Quantile", "[", 
       RowBox[{"campioni", ",", "0.001"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"xmax", "=", 
      RowBox[{"Quantile", "[", 
       RowBox[{"campioni", ",", "0.999"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Histogram", "[", 
        RowBox[{"campioni", ",", "100", ",", "\"\<PDF\>\"", ",", 
         RowBox[{"ChartStyle", "->", "Yellow"}]}], "]"}], ",", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"PDF", "[", 
          RowBox[{"dist", ",", "x"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"x", ",", "xmin", ",", "xmax"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"Red", ",", "Thick"}], "}"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"PlotRange", "->", "All"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotLabel", "->", 
        RowBox[{"Style", "[", 
         RowBox[{"titolo", ",", "14", ",", "Bold"}], "]"}]}]}], "]"}]}]}], 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9931871675657063`*^9, 3.9931872446869335`*^9}, 
   3.9931879130917816`*^9},
 CellLabel->"In[10]:=",ExpressionUUID->"4694588c-4730-7a43-99a9-d675833a24cf"]
}, Open  ]],

