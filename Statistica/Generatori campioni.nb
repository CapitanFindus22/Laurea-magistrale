Cell[CellGroupData[{

Cell["Metodo accettazione/rifiuto", "Section",
 CellChangeTimes->{{3.9931876605155373`*^9, 
  3.9931876679832516`*^9}},ExpressionUUID->"18fbb89b-e1f2-0b49-bd19-\
3c0290b99a54"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Densit\[AGrave]", " ", "obiettivo", " ", "Beta", 
    RowBox[{"(", 
     RowBox[{"2", ",", "2"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", "x_", "]"}], ":=", 
     RowBox[{"PDF", "[", 
      RowBox[{
       RowBox[{"BetaDistribution", "[", 
        RowBox[{"2", ",", "2"}], "]"}], ",", "x"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Densit\[AGrave]", " ", "proposta", " ", "U", 
     RowBox[{"(", 
      RowBox[{"0", ",", "1"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"g", "[", "x_", "]"}], ":=", 
     RowBox[{"PDF", "[", 
      RowBox[{
       RowBox[{"UniformDistribution", "[", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], "]"}], ",", "x"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Costante", " ", "tale", " ", "che", " ", "f", 
      RowBox[{"(", "x", ")"}]}], "<=", 
     RowBox[{"M", " ", "g", 
      RowBox[{"(", "x", ")"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"M", "=", 
     RowBox[{"3", "/", "2"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"campioni", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Genera", " ", "campioni", " ", "finch\[EAcute]", " ", "non", " ", "ne", " ",
      "vengono", " ", "accettati", " ", "n"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"While", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "campioni", "]"}], "<", "n"}], ",", 
      RowBox[{
       RowBox[{"y", "=", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{"UniformDistribution", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"u", "=", 
        RowBox[{"RandomReal", "[", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"u", "<=", 
          RowBox[{
           RowBox[{"f", "[", "y", "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"M", " ", 
             RowBox[{"g", "[", "y", "]"}]}], ")"}]}]}], ",", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"campioni", ",", "y"}], "]"}]}], "]"}], ";"}]}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "Grafici", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"f", "[", "x", "]"}], ",", 
           RowBox[{"g", "[", "x", "]"}], ",", 
           RowBox[{"M", " ", 
            RowBox[{"g", "[", "x", "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Red", ",", "Thick"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"Blue", ",", "Thick"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Darker", "[", "Green", "]"}], ",", "Dashed", ",", 
              "Thick"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"{", 
           
           RowBox[{"\"\<f(x)\>\"", ",", "\"\<g(x)\>\"", 
            ",", "\"\<Mg(x)\>\""}], "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<Densit\[AGrave]\>\""}]}], "]"}], ",", 
       RowBox[{"creaPlot", "[", 
        RowBox[{
         RowBox[{"BetaDistribution", "[", 
          RowBox[{"2", ",", "2"}], "]"}], ",", "campioni", 
         ",", "\"\<Campioni generati\>\""}], "]"}]}], "}"}], ",", 
     RowBox[{"ImageSize", "->", "Full"}]}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9931876900362034`*^9, 3.9931877023314476`*^9}, {
