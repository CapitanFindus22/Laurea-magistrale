Cell[CellGroupData[{

Cell["Trasformazione di Box-Muller", "Section",
 CellChangeTimes->{
  3.99318737712265*^9},ExpressionUUID->"a73c3a1a-e7c5-fc4f-b4c5-a05da26db1b9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Formule", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Z1", "=", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"-", "2"}], " ", 
        RowBox[{"Log", "[", "u1", "]"}]}], "]"}], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", " ", "Pi", " ", "u2"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Z2", "=", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"-", "2"}], " ", 
        RowBox[{"Log", "[", "u1", "]"}]}], "]"}], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"2", " ", "Pi", " ", "u2"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"1", ")"}], " ", "N", 
     RowBox[{"(", 
      RowBox[{"5", ",", "4"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mu1", "=", "5"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sigma1", "=", "2"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"1", ")"}], " ", "N", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "3"}], ",", "0.25"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mu2", "=", 
     RowBox[{"-", "3"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sigma2", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "Trasformazione", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"X", "=", 
     RowBox[{"mu1", "+", 
      RowBox[{"sigma1", " ", "Z1"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Y", "=", 
     RowBox[{"mu2", "+", 
      RowBox[{"sigma2", " ", "Z2"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "Grafici", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"GraphicsGrid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"creaPlot", "[", 
         RowBox[{
          RowBox[{"NormalDistribution", "[", 
           RowBox[{"mu1", ",", "sigma1"}], "]"}], ",", "X", 
          ",", "\"\<Normale X\>\""}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"creaPlot", "[", 
         RowBox[{
          RowBox[{"NormalDistribution", "[", 
           RowBox[{"mu2", ",", "sigma2"}], "]"}], ",", "Y", 
          ",", "\"\<Normale Y\>\""}], "]"}]}], "}"}], "}"}], ",", 
     RowBox[{"ImageSize", "->", "Full"}]}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9931873892309494`*^9, 3.993187480338234*^9}, 
